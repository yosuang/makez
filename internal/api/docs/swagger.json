        "api.SubmitRequest": {
            "type": "object",
            "required": [
                "prompt"
            ],
            "properties": {
                "agent_id": {
                    "type": "string",
                    "default": "demo"
                },
                "agent_version": {
                    "type": "string",
                    "default": "1"
                },
                "config": {
                    "type": "object"
                },
                "deadline": {
                    "description": "Deadline and timeout_seconds are mutually exclusive; an explicit deadline must be 5 seconds to 90 minutes in the future.",
                    "type": "string"
                },
                "profile_id": {
                    "type": "string",
                    "default": "default"
                },
                "profile_version": {
                    "type": "string",
                    "default": "1"
