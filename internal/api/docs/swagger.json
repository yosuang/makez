                "prompt": {
                    "description": "Prompt is required and must contain 1–65536 UTF-8 bytes after checking for blank input.",
                    "type": "string"
                },
                "timeout_seconds": {
                    "type": "integer",
                    "default": 3600,
                    "maximum": 5400,
                    "minimum": 5
                }
            }
        },
